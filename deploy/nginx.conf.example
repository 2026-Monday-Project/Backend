# /etc/nginx/conf.d/monday.conf 로 배치할 참고용 템플릿.
# `certbot --nginx -d api.love-garden.site` 실행 시 이 파일의 listen/ssl 관련 지시문은 Certbot이 자동으로 덧붙인다.

server {
    listen 80;
    server_name api.love-garden.site;

    # 사연 사진 업로드(사진 최대 5장 x 20MB)가 Nginx 단에서 먼저 막히지 않도록 설정
    client_max_body_size 110m;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
