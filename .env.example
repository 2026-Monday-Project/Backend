# EC2에서 이 파일을 복사해 .env로 만들고 실제 값을 채운다. (.env는 절대 git에 올리지 않는다)
# 사용: docker run --env-file .env -p 127.0.0.1:8080:8080 monday:latest

# --- Database (RDS) ---
DB_URL=jdbc:mysql://<rds-endpoint>:3306/mondayprj?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=
DB_PASSWORD=

# --- S3 (이미지 저장) ---
AWS_REGION=ap-northeast-2
S3_BUCKET=mondayprj
S3_BASE_URL=https://mondayprj.s3.ap-northeast-2.amazonaws.com
# EC2 인스턴스에 S3 접근 IAM Role이 연결되어 있으면 액세스 키는 별도로 넣지 않아도 된다.

# --- JWT ---
# 32자 이상, 로컬 개발용 값과 다른 새 값으로 발급할 것
JWT_SECRET=
JWT_EXPIRATION_MINUTES=720

# --- Admin 계정 ---
ADMIN_USERNAME=admin
# BCrypt 해시값 (원문 비밀번호가 아님)
ADMIN_PASSWORD_HASH=

# --- CORS ---
# 프론트엔드가 실제로 서빙되는 운영 도메인. 여러 개면 콤마로 구분
CORS_ALLOWED_ORIGINS=https://love-garden.site
